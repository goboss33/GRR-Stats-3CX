      "FLOW_FREE": "Microsoft Power Automate Free",
      "RIGHTSMANAGEMENT_ADHOC": "Azure Rights Management",
      "DYN365_TEAM_MEMBERS": "Dynamics 365 Team Members"
    },
    "cacheDelegationsHeures": 240,
    "reponsesAutomatiques": {
      "_commentaire": "Modèles proposés à la sortie. Variables remplies par le script : {Prenom} {Nom} {NomComplet} {Societe} {Date} {Successeur} {SuccesseurEmail} (les deux dernières viennent de la redirection choisie) ; toute autre {Variable} est demandée à l'opérateur. Sauts de ligne : \\n.",
      "modeles": [
        { "id": "standard",   "nom": "Départ — standard",              "texte": "Bonjour,\n\nJe ne fais plus partie de {Societe}. Merci d'adresser désormais vos demandes à {SuccesseurEmail}.\n\nMeilleures salutations" },
        { "id": "successeur", "nom": "Départ — avec successeur nommé", "texte": "Bonjour,\n\nJe ne fais plus partie de {Societe} depuis le {Date}. {Successeur} ({SuccesseurEmail}) reprend mes dossiers et se tient à votre disposition.\n\nMeilleures salutations" },
        { "id": "sansContact", "nom": "Départ — sans contact indiqué", "texte": "Bonjour,\n\nJe ne fais plus partie de {Societe}. Votre message ne sera pas traité : merci de vous adresser à votre interlocuteur habituel ou au secrétariat.\n\nMeilleures salutations" }
      ]
    }
  },

  "pbx": {
    "_commentaire": "Un PBX par clé ; chaque société pointe sur une clé (ou null si pas de XAPI). Le secret est lu dans le fichier chiffré indiqué, créé par Set-Secret.ps1. Utilisez de préférence un principal DÉDIÉ aux scripts (ID client distinct de celui de l'application de statistiques).",
    "gerofinance": {
      "adresse": "https://gerofinance.3cx.ch:5001",
      "clientId": "stats",
      "fichierSecret": "secrets\\xapi.gerofinance.bin",
      "motifPosteLibre": "\\blibre\\b",
      "skillGroupParDefaut": "1"
    }
  },

