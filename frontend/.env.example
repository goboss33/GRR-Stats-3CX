# Database - Legacy (à supprimer après migration)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/callcenter?connection_limit=10&pool_timeout=20"

# Database - Nouvelle architecture multi-tenant
DATABASE_URL_AUTH="postgresql://postgres:postgres@localhost:5432/callcenter_auth?connection_limit=10&pool_timeout=20"
DATABASE_URL_GEROFINANCE="postgresql://postgres:postgres@localhost:5432/callcenter_gerofinance?connection_limit=10&pool_timeout=20"
DATABASE_URL_EDIFEA="postgresql://postgres:postgres@localhost:5432/callcenter_edifea?connection_limit=10&pool_timeout=20"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Microsoft Entra ID (Azure AD) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"
AUTH_MICROSOFT_ENTRA_ID_SECRET="<Client Secret>"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="<Directory (tenant) ID>"

# Azure AD Security Groups Object IDs
AZURE_GROUP_ADMIN_ID="<Object ID du groupe SEC_STATS_3CX-Admins>"
AZURE_GROUP_SUPERUSER_ID="<Object ID du groupe SEC_STATS_3CX-SuperUsers>"
AZURE_GROUP_MODERATOR_ID="<Object ID du groupe SEC_STATS_3CX-Moderators>"
AZURE_GROUP_USER_ID="<Object ID du groupe SEC_STATS_3CX-Users>"

# Backend API
BACKEND_URL="http://localhost:8000"

# Internal API configuration (for server actions calling analytics API)
INTERNAL_API_URL="http://127.0.0.1:3000"
INTERNAL_API_KEY="your-internal-api-key"

# Seed — mot de passe des comptes de démo créés par `npm run db:seed`
# (min. 8 caractères ; requis, plus de valeur en dur dans le code)
SEED_ADMIN_PASSWORD="change-me-strong-password"
