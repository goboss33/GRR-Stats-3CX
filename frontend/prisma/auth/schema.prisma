generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/auth-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_AUTH")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  firstName      String?
  lastName       String?
  role           Role      @default(AGENT)
  authProvider   String    @default("CREDENTIALS")
  azureAdId      String?   @unique
  profilePicture String?
  jobTitle       String?
  department     String?
  mobilePhone    String?
  officeLocation String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Dernière connexion réussie (horodatée par l'événement signIn de NextAuth,
  /// quel que soit le fournisseur — mot de passe ou Microsoft).
  lastLoginAt    DateTime?
  /// Dernière ACTIVITÉ : mise à jour au fil des requêtes authentifiées, avec un
  /// throttle d'une heure (cf. session callback) — une session JWT de 30 jours
  /// rend lastLoginAt trop grossier pour lire « qui utilise l'app ».
  lastSeenAt     DateTime?

  /// Permissions individuelles (cf. PRD droits d'accès §4.3) — restrictives par
  /// défaut : on n'accorde que ce qui est explicitement coché par un ADMIN.
  /// Exception : canViewLogs, ouvert par défaut — les logs sont le détail
  /// derrière chaque KPI, on RETIRE ce droit plutôt qu'on ne l'accorde.
  /// (canViewCompanyWide a disparu en août 2026 : le tableau de bord est
  /// toujours filtré par périmètre — cf. lib/startup-migrations.)
  canViewLogs             Boolean  @default(true)
  canViewExtensionStats   Boolean  @default(true)
  canViewFullPhoneNumbers Boolean  @default(false)
  canCreateApiKeys        Boolean  @default(false)
  /// Voir la cloche d'alertes (anomalies détectées dans son périmètre).
  /// `null` = non arbitré -> défaut par rôle : activé pour ADMIN/MODERATOR,
  /// désactivé pour MANAGER (cf. lib/notification-access).
  canViewNotifications    Boolean?
  /// Ratios (dénominateurs « 85/111 ») du tableau de performance des agents :
  /// "none" = aucun, "totals" = ligne TOTAL seule, "all" = toutes les lignes.
  /// `null` = non arbitré -> défaut par rôle : "all" pour ADMIN/MODERATOR,
  /// "none" pour les autres (cf. lib/ratios-access).
  agentRatiosLevel        String?

  tenantAccess       UserTenantAccess[]
  queuePerimeter     UserQueuePerimeter[]
  extensionOverrides UserExtensionOverride[]
  queueFavorites     UserQueueFavorite[]
}

/// Rôles applicatifs (cf. PRD droits d'accès §4).
/// ADMIN     : l'IT — accès total, gère utilisateurs / tenants / configuration
/// MODERATOR : prestataire ou analyste externe — consultation globale, aucune administration
/// MANAGER   : responsable d'agence — consultation limitée à son périmètre
/// AGENT     : collaborateur — aucun accès pour l'instant
///
/// ⚠️ MANAGER et AGENT s'appelaient SUPERUSER et USER. Le renommage en base est
/// assuré par lib/startup-migrations.ts (ALTER TYPE ... RENAME VALUE, idempotent),
/// exécuté au démarrage du serveur via instrumentation.ts.
enum Role {
  ADMIN
  MODERATOR
  MANAGER
  AGENT
}

/// Alertes ignorées « définitivement » — GLOBAL (partagé entre lecteurs) :
/// « ce poste a été retiré de la file » est un fait d'organisation, pas une
/// préférence. Rien n'est perdu : les alertes étant recalculées à la lecture,
/// ignorer = filtrer à l'affichage ; l'onglet Ignorées permet de restaurer.
/// `alertId` = identifiant stable de l'anomalie (type:file[:poste]).
model AlertIgnore {
  id            String   @id @default(cuid())
  tenantId      String
  alertId       String
  ignoredById   String?
  ignoredByName String
  createdAt     DateTime @default(now())

  @@unique([tenantId, alertId])
}

model AppSettings {
  id                          String    @id @default("global")
  minSignificantDurationSec   Int       @default(1)
  /// Interrupteur global du filtrage par périmètre (cf. PRD §12).
  /// Reste à false le temps de classer les files et d'affecter les périmètres :
  /// l'activer avant rendrait tous les écrans vides pour les non-ADMIN.
  perimeterEnforcementEnabled Boolean   @default(false)
  /// Nombre de jours sans appel avant qu'une file passe en ARCHIVED.
  queueArchiveAfterDays       Int       @default(90)
  /// Masquer les files ARCHIVED des listes (sidebar, sélecteur, aperçu des
  /// groupes). Filtre d'AFFICHAGE seulement : périmètres, statistiques des
  /// périodes passées et journaux restent accessibles par lien direct.
  hideArchivedQueues          Boolean   @default(true)
  /// Fenêtre d'observation (jours) du détecteur d'anomalies de la cloche
  /// d'alertes — cf. services/notifications.service.
  notificationWindowDays      Int       @default(7)
  /// Horodate l'amorçage des périmètres ADMIN/MODERATOR (août 2026 : ces rôles
  /// ont cessé de tout voir par défaut). Ne rejoue jamais : sans ce marqueur,
  /// chaque démarrage réattribuerait les files qu'un administrateur a retirées.
  adminPerimeterSeededAt      DateTime?

  // ---- Règles de classement des appels (cf. services/domain/call-classification.ts)
  // Les valeurs par défaut reproduisent DEFAULT_CLASSIFICATION_RULES : une base
  // neuve se comporte donc exactement comme avant l'introduction de ces champs.
  // ⚠️ Ces règles s'appliquent AU CALCUL : les modifier change rétroactivement
  // les chiffres des périodes passées.

  /// Appel repassant dans la même file : "best" | "last" | "each"
  ruleMultiPassage             String   @default("best")
  /// Débordement vers une autre file : "neutral" | "lost" | "answered"
  ruleOverflow                 String   @default("neutral")
  /// Seuil des abandons courts, en secondes. `null` désactive la règle.
  ruleShortAbandonSec          Int?     @default(10)
  /// Sort des abandons courts : "lost" (comptés dans Perdus) | "excluded"
  /// (pas comptés du tout — l'appel sort des reçus)
  ruleShortAbandonDisposition  String   @default("lost")
  /// Horloge du seuil d'abandon court : "passage" (le passage en file seul) |
  /// "team" (cumul de la sollicitation de l'équipe : directs + file)
  ruleShortAbandonClock        String   @default("passage")
  /// Appel direct ET en file : "firstContact" | "queueWins" | "both"
  ruleDirectAndQueue           String   @default("firstContact")
  /// Messagerie : "separate" | "lost" | "answered" | "excluded"
  ruleVoicemail                String   @default("separate")
  /// Statut final hors périmètre : "name" | "anonymize" | "hide"
  ruleOutOfScopeFinalStatus    String   @default("name")
  /// Unité de comptage : "leg" (jambe 3CX) | "merged" (jambes de transfert
  /// fusionnées dans l'appel principal — exige la vue cdroutput_merged,
  /// cf. prisma/cdr/sql/001_effective_call_id.sql)
  ruleCallGrain                String   @default("leg")
  /// Appel répondu puis servi hors du groupe : "overflow" (Transféré) | "answered"
  ruleAnsweredThenTransferred  String   @default("overflow")
  /// Crédit du tableau par agent : "lastAnswer" (dernier décrocheur) | "each"
  ruleAgentCredit              String   @default("lastAnswer")
  /// Transfert accompli dans la performance : "success" | "neutral"
  ruleHandedOffInPerformance   String   @default("success")
  /// Sonnerie directe non répondue partie vers la file d'une autre équipe :
  /// "lost" (Perdu) | "overflow" (Débordé, rangé dans les Débordements)
  ruleUnansweredDirectOverflow String   @default("lost")
  /// Durée minimale d'une conversation pour qu'un décroché compte comme répondu.
  ruleMinAnswerSec             Int      @default(1)
  /// Source de l'équipe : "activity" (déduite des sollicitations de la
  /// fenêtre — l'historique) | "journalAuto" (journal de composition XAPI dès
  /// le premier mois calendaire entièrement couvert ; strictement équivalent
  /// à "activity" tant qu'aucun journal n'existe, d'où ce défaut).
  ruleRosterSource             String   @default("journalAuto")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

/// Registre des files d'attente — SOURCE DE VÉRITÉ des droits.
///
/// Pourquoi une table plutôt que les noms lus dans les CDR ? Parce que les files
/// sont renommées dans 3CX (constaté : « RC BULLE Gérance » → « RC FRIBOURG
/// Gérance »). Déduire les droits du nom ouvrirait/fermerait des accès
/// silencieusement. Le périmètre s'appuie donc sur le NUMÉRO, jamais sur le nom.
///
/// Sans XAPI 3CX, les files sont découvertes via les CDR : une nouvelle file
/// n'apparaît qu'après son premier appel, et une file supprimée ne disparaît
/// jamais (d'où le statut ARCHIVED).
model QueueRegistry {
  id                String      @id @default(cuid())
  tenantId          String
  queueNumber       String
  currentName       String
  /// Étiquettes d'aide à la sélection (pré-remplies, validées par un ADMIN).
  /// Elles ne définissent JAMAIS les droits à elles seules.
  entity            String?
  region            String?
  service           String?
  status            QueueStatus @default(ACTIVE)
  /// DÉPRÉCIÉ (août 2026) — plus lu par aucun écran. Les clients hébergés
  /// sortent désormais des chiffres parce qu'ils ne sont dans le périmètre de
  /// personne, et non parce qu'on efface leurs appels de toutes les vues :
  /// l'ancien mécanisme faisait aussi disparaître la part travaillée par nos
  /// équipes sur les appels mixtes, journaux compris.
  /// Conservé le temps que l'amorçage des périmètres (startup-migrations) en
  /// tire le périmètre initial des administrateurs ; supprimable ensuite.
  excludedFromStats Boolean     @default(false)
  /// null = jamais examinée par un ADMIN -> signalée comme « nouvelle ».
  /// Remplace l'ancien statut « à classer », qui empêchait d'utiliser une file
  /// sans rien protéger : la sécurité vient du périmètre, pas du statut.
  reviewedAt        DateTime?
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  nameHistory QueueNameHistory[]
  perimeters  UserQueuePerimeter[]

  @@unique([tenantId, queueNumber])
  @@index([tenantId, status])
}

/// Files favorites d'un utilisateur : épinglées en tête du sous-menu
/// « Mes équipes » (et demain des cartes du tableau de bord). Purement
/// personnel — aucun effet sur les droits ni sur les chiffres.
model UserQueueFavorite {
  userId      String
  tenantId    String
  queueNumber String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, queueNumber])
}

enum QueueStatus {
  /// File exploitable dans les périmètres
  ACTIVE
  /// Sans appel depuis queueArchiveAfterDays — probablement supprimée dans 3CX
  ARCHIVED
}

/// Historique des noms d'une file : trace les renommages afin d'alerter l'ADMIN
/// (« cette file a changé de région, vérifiez les périmètres »).
model QueueNameHistory {
  id      String        @id @default(cuid())
  queueId String
  queue   QueueRegistry @relation(fields: [queueId], references: [id], onDelete: Cascade)
  name    String
  seenAt  DateTime      @default(now())

  @@unique([queueId, name])
}

/// Tenants auxquels un utilisateur a accès (accordés par un ADMIN, cf. PRD D8).
model UserTenantAccess {
  userId   String
  tenantId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
}

/// Périmètre : liste EXPLICITE de files.
/// Aucune règle dynamique — une nouvelle file n'entre jamais seule dans un périmètre.
///
/// DOCTRINE DÉPARTEMENTS (arrêtée en août 2026, avant le nettoyage 3CX) : le
/// futur sélecteur par départements dans l'affectation des droits doit rester
/// un raccourci STATIQUE — cocher un département coche ses files du moment,
/// et c'est toujours une liste de files qui est enregistrée ici (on peut
/// ensuite en retirer, ou n'affecter qu'une file isolée). Ne passer en
/// rattachement DYNAMIQUE (le périmètre suivrait le département, nouvelles
/// files comprises) que le jour où la XAPI 3CX fournira la composition en
/// FAIT établi : aujourd'hui le lien file↔département est DÉDUIT des CDR
/// (destination_participant_group_name, couverture partielle) — adosser des
/// droits d'accès à une donnée déduite reproduirait le problème « équipe de
/// Nyon » appliqué à la sécurité.
model UserQueuePerimeter {
  userId  String
  queueId String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue   QueueRegistry @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
}

/// Surcharge manuelle du rattachement d'une extension à un utilisateur.
/// Nécessaire car 42 % des extensions ne servent aucune file (direction,
/// back-office…) et ne peuvent donc pas être rattachées automatiquement.
model UserExtensionOverride {
  id              String       @id @default(cuid())
  userId          String
  tenantId        String
  extensionNumber String
  mode            OverrideMode
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, extensionNumber])
}

enum OverrideMode {
  INCLUDE
  EXCLUDE
}

/// Rattachement matérialisé extension → file, reconstruit par la découverte.
/// Matérialisé car le calcul (jointure sur les segments de sollicitation) est
/// trop coûteux pour être refait à chaque requête.
model QueueAgentLink {
  id              String   @id @default(cuid())
  tenantId        String
  queueNumber     String
  extensionNumber String
  lastSeenAt      DateTime
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, queueNumber, extensionNumber])
  @@index([tenantId, extensionNumber])
}

model TenantSettings {
  serverId           String    @id
  timezone           String    @default("Europe/Zurich")
  licenceThreshold   Int?
  trunkThreshold     Int?
  /// SURCOUCHE XAPI (août 2026) — interrogation directe du 3CX, activable et
  /// désactivable par tenant. Le socle CDR reste la source de vérité en toute
  /// circonstance : rien de ce qui existe ne doit dépendre de cet
  /// interrupteur, XAPI ne fait qu'AJOUTER par-dessus.
  xapiEnabled        Boolean   @default(false)
  /// Adresse du PBX, port compris (ex. https://exemple.3cx.ch:5001). En base
  /// et non en variable d'environnement : un tenant = un serveur, et
  /// l'administrateur doit pouvoir corriger une adresse sans redéploiement.
  xapiBaseUrl        String?
  /// « ID client » du principal de service 3CX (v20) — PAS un secret : la
  /// paire ID client + clé s'échange contre un jeton temporaire.
  xapiClientId       String?
  /// Clé XAPI CHIFFRÉE (AES-256-GCM, cf. lib/secret-box) — jamais en clair en
  /// base, jamais renvoyée au navigateur. Credential SORTANT : contrairement
  /// aux clés API entrantes (ApiKey.keyHash, bcrypt), il faut pouvoir la
  /// relire pour appeler le 3CX, donc chiffrement réversible et non hachage.
  xapiKeyEncrypted   String?
  /// Date de dernière saisie de la clé — seule trace montrable à l'écran.
  xapiKeyUpdatedAt   DateTime?
  /// DÉPRÉCIÉ (août 2026) — plus lu par aucun écran, voir
  /// QueueRegistry.excludedFromStats. Les postes hors file sont désormais
  /// visibles des seuls rôles globaux, via leur périmètre.
  excludedExtensions String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ApiKey {
  id             String    @id @default(cuid())
  keyHash        String    @unique
  name           String
  description    String?
  quotaPerMinute Int       @default(100)
  isActive       Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedBy      String?

  @@index([isActive])
  @@index([createdBy])
}

model SearchPreset {
  id        String   @id @default(cuid())
  userId    String
  page      String   @default("statistics-extension")
  name      String
  entries   Json
  createdAt DateTime @default(now())

  @@index([userId, page])
}

/// SURCOUCHE XAPI — journal de composition des équipes, relevé chaque nuit.
/// Un enregistrement = un intervalle CONTINU d'appartenance d'un poste à une
/// file, avec le nom porté pendant l'intervalle. Un changement de titulaire
/// (Nicole → Martine sur le même poste) FERME l'intervalle et en ouvre un
/// nouveau : les noms d'époque restent des données de première classe, comme
/// dans le socle CDR. Le journal ne réécrit jamais le passé — il l'enregistre.
/// Annuaire des files RELEVÉ PAR XAPI — nom et département, datés.
///
/// Le nom déduit des CDR est celui du dernier appel, et les étiquettes du
/// registre sont analysées une fois puis figées : les deux divergeaient de la
/// réalité dès qu'une file changeait de nom ou d'entité (la file 925 restait
/// « RC BULLE » alors que le PBX la place dans « GRR BULLE »). Seul le PBX
/// fait autorité, et il le dit en un appel : Queues?$expand=Agents,Groups.
///
/// Même doctrine que les appartenances : un renommage ou un changement de
/// département FERME la ligne et en OUVRE une nouvelle. On date, on n'écrase
/// jamais.
model QueueDirectoryInterval {
  id          String    @id @default(cuid())
  serverId    String
  queueNumber String
  /// Nom de la file au PBX, à l'époque de cette ligne.
  queueName   String
  /// Département (« groupe » 3CX). null = la file n'en a aucun.
  department  String?
  firstSeenAt DateTime
  lastSeenAt  DateTime
  /// Relevé qui a constaté le changement ; null = valeurs à ce jour.
  closedAt    DateTime?

  @@index([serverId, queueNumber, closedAt])
  @@index([serverId, closedAt])
}

model QueueMembershipInterval {
  id          String    @id @default(cuid())
  serverId    String
  queueNumber String
  extension   String
  agentName   String
  /// Premier relevé où le poste a été vu membre de la file.
  firstSeenAt DateTime
  /// Dernier relevé où il l'était encore.
  lastSeenAt  DateTime
  /// Relevé qui a constaté la disparition ; null = membre à ce jour.
  closedAt    DateTime?

  @@index([serverId, queueNumber, closedAt])
  @@index([serverId, closedAt])
}

/// Trace de chaque relevé XAPI — l'onglet des réglages s'en nourrit, et un
/// échec y laisse son motif exact plutôt que de disparaître dans les logs.
model XapiSnapshotRun {
  id       String   @id @default(cuid())
  serverId String
  ranAt    DateTime @default(now())
  ok       Boolean
  /// Files lues, postes membres vus, et mouvements (apparitions + départs
  /// + changements de titulaire) par rapport au relevé précédent.
  queues   Int      @default(0)
  members  Int      @default(0)
  changes  Int      @default(0)
  error    String?

  @@index([serverId, ranAt(sort: Desc)])
}
